{
	"name": "@Qazzian/pixel-game-engine",
	"version": "0.1.8",
	"description": "Simple game engine inspired by OneLoneCoder",
	"main": "cjs/index.js",
	"module": "esm/index.js",
	"type": "module",
	"types": "esm/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"src"
	],
	"scripts": {
		"prepare": "npm run build",
		"prebuild": "npm run clean",
		"build": "npm run build:esm && npm run build:cjs",
		"build:esm": "tsc",
		"build:cjs": " npx rollup esm/index.js --file cjs/index.js --format cjs",
		"build:watch": "tsc -w",
		"clean": "rimraf esm cjs",
		"lint": "prettier . --write && eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run",
		"test:watch": "vitest run --watch",
		"prepush": "npm run lint && npm run test -- --color && npm run build",
		"preversion": "build",
		"postVersion": "git push && git push --tags",
		"test:coverage": "vitest run --coverage"
	},
	"author": "Qazzian",
	"license": "ISC",
	"devDependencies": {
		"@babel/core": "^8.0.6",
		"@babel/preset-env": "^8.0.6",
		"@babel/preset-typescript": "^8.0.1",
		"@eslint/js": "^10.0.1",
		"@tsconfig/node-lts": "^24.0.1",
		"@types/jsdom": "^30.0.0",
		"@types/random-seed": "^0.3.3",
		"@vitest/coverage-v8": "^5.0.1",
		"canvas": "^3.2.0",
		"eslint": "^10.11.0",
		"eslint-plugin-jest": "^29.16.6",
		"html-webpack-plugin": "^5.6.8",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.9",
		"rimraf": "^6.0.1",
		"rollup": "^4.63.4",
		"ts-node": "^10.9.2",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.70.1",
		"vitest": "^5.0.1",
		"vitest-canvas-mock": "^1.2.0"
	},
	"dependencies": {
		"random-seed": "^0.3.0",
		"typescript-event-target": "^1.1.1"
	}
}
